<Page x:Class="WPF16.Pages.EndPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF16.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EndPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="StatusTB" Text="Вы проиграли!" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10, 10, 10, 10"/>
            <TextBlock x:Name="DescriptionTB" Text="Вы проиграли!" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10, 10, 10, 10"/>
         </StackPanel>
            
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="RestartBtn" Content="Начать заново" Height="40" Width="90" Margin="10, 10, 10, 10" Click="RestartBtn_Click"/>
            <Button x:Name="ExitBtn" Content="Выйти" Height="40" Width="90" Margin="10, 10, 10, 10" Click="ExitBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
