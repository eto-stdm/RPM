<Page x:Class="WPF16.Pages.NamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF16.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NamePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Text="Введите своё имя:" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10, 10, 10, 10" Grid.Row="1"/>
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <TextBox x:Name="CharName" Width="200" Height="40" Margin="10,10,10,10" VerticalContentAlignment="Center" HorizontalAlignment="Center"/>
            <Button x:Name="ContinueBtn" Width="100" Height="30" Content="Продолжить" Margin="10,0,10,10" Click="ContinueBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
