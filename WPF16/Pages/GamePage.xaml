<Page x:Class="WPF16.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF16.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GamePage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="120"></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Text="Крутая игра" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10, 10, 10, 10" Grid.Row="0" Grid.ColumnSpan="2"/>
        <TextBlock x:Name="FloorTB" Text="Этаж:" Margin="10,0,10,0" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
        <TextBlock x:Name="HPTB" Text="Здоровье:" Margin="10,0,10,0" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1"/>

        <StackPanel  Grid.Row="3" Grid.Column="0">
            <TextBlock x:Name="ItemsTB" Text="Вещи:" Margin="10,0,10,0" VerticalAlignment="Top"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image x:Name="Item1" Source="/Imgs/placeholder.jpg" Width="80" Height="80" Margin="10" ToolTip="123"/>
                <Image x:Name="Item2" Source="/Imgs/placeholder.jpg" Width="80" Height="80" Margin="10" ToolTip="456"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer x:Name="LogScroll" Grid.Row="3" Grid.Column="1">
            <TextBlock x:Name="LogTB" Text="Лог:" Margin="10,0,10,0" />
        </ScrollViewer>


        <StackPanel Orientation="Vertical" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="Enemy1" Source="/Imgs/placeholder.jpg" Width="180" Height="180" Margin="10"/>
                <Image x:Name="Enemy2" Source="/Imgs/placeholder.jpg" Width="180" Height="180" Margin="10"/>
                <Image x:Name="Enemy3" Source="/Imgs/placeholder.jpg" Width="180" Height="180" Margin="10"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AttackBtn" Content="Атаковать" Width="70" Height="30" Margin="10" Click="AttackBtn_Click"/>
                <Button x:Name="DefendBtn" Content="Защищаться" Width="70" Height="30" Margin="10" Click="DefendBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
