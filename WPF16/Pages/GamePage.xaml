<Page x:Class="WPF16.Pages.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF16.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GamePage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="30"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="120"></RowDefinition>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#eeeefc"/>
        <Border Grid.Row="1" Grid.Column="0" Background="#f8eefc"/>
        <Border Grid.Row="1" Grid.Column="1" Background="#fceef1"/>
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#fcfcee"/>
        <Border Grid.Row="3" Grid.Column="0" Background="#eefcfc"/>
        <Border Grid.Row="3" Grid.Column="1" Background="#eefcef"/>

        
        
        <TextBlock Text="Крутая игра" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10, 10, 10, 10" Grid.Row="0" Grid.ColumnSpan="2"/>

        <Grid VerticalAlignment="Center" Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"></ColumnDefinition>
                <ColumnDefinition Width="200"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FloorTB" Text="Этаж:" Margin="10,0,10,0" Grid.Column="0"/>
            <TextBlock x:Name="StepTB" Text="Ход:" Margin="10,0,10,0" Grid.Column="1" Visibility="Hidden"/>
        </Grid>

        <TextBlock x:Name="HPTB" Text="Здоровье:" Margin="10,0,10,0" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1"/>

        <StackPanel Grid.Row="3" Grid.Column="0">
            <TextBlock x:Name="ItemsTB" Text="Вещи:" Margin="10,0,10,0" VerticalAlignment="Top"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image x:Name="WeaponImg" Width="80" Height="80" Margin="10,10,50,10" ToolTip="123"/>
                <Image x:Name="ArmorImg" Width="80" Height="80" Margin="10" ToolTip="456"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer x:Name="LogScroll" Grid.Row="3" Grid.Column="1">
            <TextBlock x:Name="LogTB" Text="Лог:" Margin="10,0,10,0" />
        </ScrollViewer>

        <StackPanel Orientation="Vertical" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image x:Name="ObjectImg" Width="150" Height="150" Margin="10" Visibility="Hidden"/>
                <!-- <Image x:Name="Enemy2" Source="/Imgs/placeholder.jpg" Width="180" Height="180" Margin="10"/> -->
                <!-- <Image x:Name="Enemy3" Source="/Imgs/placeholder.jpg" Width="180" Height="180" Margin="10"/> -->
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AttackBtn" Content="Атаковать" Width="70" Height="25" Margin="10,0,10,10" Click="AttackBtn_Click" Visibility="Collapsed"/>
                <Button x:Name="DefendBtn" Content="Защищаться" Width="70" Height="25" Margin="10,0,10,10" Click="DefendBtn_Click" Visibility="Collapsed"/>
                <Button x:Name="RoomBtn" Content="Войти в комнату" Width="100" Height="25" Margin="10,0,10,10" Click="RoomBtn_Click" Visibility="Collapsed"/>
                <Button x:Name="TakeItemBtn" Content="Взять предмет" Width="100" Height="25" Margin="10,0,10,10" Click="TakeItemBtn_Click" Visibility="Collapsed"/>
                <Button x:Name="LeaveItemBtn" Content="Оставить предмет" Width="110" Height="25" Margin="10,0,10,10" Click="LeaveItemBtn_Click" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
