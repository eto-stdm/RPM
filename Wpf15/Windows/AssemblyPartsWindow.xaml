<Window x:Class="Wpf15.Windows.AssemblyPartsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf15.Windows"
        mc:Ignorable="d"
        Title="AssemblyPartsWindow" Height="450" Width="700">
    <Grid Background="#ffd4b8">
        <StackPanel>
            <TextBlock x:Name="NameTB" Text="Сборка: " HorizontalAlignment="Center" TextWrapping="Wrap" Margin="10,10,10,10"/>
            <TextBlock x:Name="AuthorTB" Text="Автор: " HorizontalAlignment="Center" TextWrapping="Wrap" Margin="10,0,10,10"/>

            <TextBlock x:Name="CPUTB" Text="CPU: " Margin="10,10,10,10" TextWrapping="Wrap"/>
            <TextBlock x:Name="GPUTB" Text="GPU: " Margin="10,0,10,10" TextWrapping="Wrap"/>
            <TextBlock x:Name="RAMTB" Text="RAM: " Margin="10,0,10,10" TextWrapping="Wrap"/>
            <TextBlock x:Name="MotherboardTB" Text="Motherboard: " Margin="10,0,10,10" TextWrapping="Wrap"/>
            <TextBlock x:Name="CaseTB" Text="Case: " Margin="10,0,10,10" TextWrapping="Wrap"/>
            <TextBlock x:Name="PowerSupplyTB" Text="PowerSupply: " Margin="10,0,10,10" TextWrapping="Wrap"/>
            <TextBlock x:Name="ProcessorCoolerTB" Text="ProcessorCooler: " Margin="10,0,10,10" TextWrapping="Wrap"/>
            <TextBlock x:Name="StorageDeviceTB" Text="StorageDevice: " Margin="10,0,10,10" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
