<Window x:Class="Wpf15.Windows.SaveAssemblyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf15.Windows"
        mc:Ignorable="d"
        Title="SaveAssemblyWindow" Height="450" Width="300">
    <Grid Background="#ffd4b8">
        <StackPanel>
            <TextBlock Text="Сохранение сборки" HorizontalAlignment="Center" Margin="10,10,10,10"/>

            <TextBox x:Name="NameTB" Text="Сборка: " HorizontalAlignment="Center" TextWrapping="Wrap" Margin="10,10,10,10"/>
            <TextBox x:Name="AuthorTB" Text="Автор: " HorizontalAlignment="Center" TextWrapping="Wrap" Margin="10,0,10,10"/>
        </StackPanel>
    </Grid>
</Window>
