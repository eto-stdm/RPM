<Window x:Class="Wpf15.Windows.SaveAssemblyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf15.Windows"
        mc:Ignorable="d"
        Title="SaveAssemblyWindow" Height="200" Width="300">
    <Grid Background="#ffd4b8">
        <StackPanel>
            <TextBlock Text="Сохранение сборки" HorizontalAlignment="Center" Margin="10,10,10,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Название:" Margin="10,10,10,10"/>
                    <TextBox x:Name="NameTB" Width="100" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,10,10,10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Автор:" Margin="10,0,10,10"/>
                <TextBox x:Name="AuthorTB" Width="100" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,10"/>
            </StackPanel>
            <Button x:Name="SaveBtn" Content="Сохранить" Width="100" Height="20" Margin="10,10,10,10" Click="SaveBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
