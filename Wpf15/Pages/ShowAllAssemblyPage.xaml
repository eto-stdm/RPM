<Page x:Class="Wpf15.Pages.ShowAllAssemblyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ShowAllAssemblyPage">

    <Grid>
        <Grid VerticalAlignment="Top" MinHeight="50" MaxHeight="50">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Button x:Name="MainBtn" Margin="10,10,10,10" Click="MainBtn_Click" Grid.Row="0" Grid.Column="0">
                <Image Source="/Images/dns.png"/>
            </Button>
            <TextBlock Text="Сохранённые сборки" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,10,100,10" Grid.Row="0" Grid.Column="1"/>
        </Grid>
        <ListBox x:Name="AssemblyLB" MouseDoubleClick="MouseDoubleClick" Background="#fffcfa" ItemsSource="{Binding Path=assemblies}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top" Margin="150,60,150,30" MinHeight="330" MaxHeight="1000">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="500" Height="50">
                        <StackPanel>
                            <TextBlock x:Name="NameTB" Text="{Binding name, StringFormat=Название сборки: {0}}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AuthorTB" Text="{Binding author, StringFormat=Автор: {0}}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
