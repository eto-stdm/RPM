<Page x:Class="Wpf15.Pages.SelectPartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SelectPartPage">

    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" MinHeight="50" MaxHeight="50">
            <Button x:Name="MainBtn" Margin="10,10,10,10" Click="MainBtn_Click">
                <Image Source="/Images/dns.png"/>
            </Button>
            <TextBox x:Name="SearchTB" Width="600" Margin="0,10,10,10" VerticalContentAlignment="Center"/>
            <Button x:Name="SerachBtn" Width="40" Content="🔍" Margin="0,10,10,10" Click="SerachBtn_Click"/>
            <TextBlock Width="20" Text="🍸" VerticalAlignment="Center" Margin="0,10,0,10"/>
            <ComboBox x:Name="ManufCB" Width="20" Margin="0,10,10,10" SelectionChanged="ManufCB_SelectionChanged"/>
        </StackPanel>
        <ListBox x:Name="PartsLB" Background="#fffcfa" ItemsSource="{Binding Path=baseparts}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Bottom" Margin="10,0,10,10" MinHeight="100" MaxHeight="350">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="280" Width="150" Margin="15,10,10,15">
                        <StackPanel Margin="10,10,10,10">
                            <Image Width="130" Height="130" Source="{Binding image}"/>
                            <TextBlock x:Name="NameTB" Text="{Binding name}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ParttypeTB" Text="{Binding parttype.getname}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ManufacturerTB" Text="{Binding manufacturer.getname}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PriceTB" Text="{Binding price, StringFormat=Цена: {0}}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="AddToAssembly_Btn" Content="Добавить в сборку" Click="AddToAssembly_Btn_Click" VerticalAlignment="Bottom"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
