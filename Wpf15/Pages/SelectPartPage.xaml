<Page x:Class="Wpf15.Pages.SelectPartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SelectPartPage">

    <Grid>
        <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch" MinHeight="50" MaxHeight="50" Width="Auto">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="50"></ColumnDefinition>
                <ColumnDefinition Width="20"></ColumnDefinition>
                <ColumnDefinition Width="30"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Button x:Name="MainBtn" Margin="10,10,10,10" Click="MainBtn_Click" Width="50" Grid.Row="0" Grid.Column="0">
                <Image Source="/Images/dns.png"/>
            </Button>
            <TextBox x:Name="SearchTB"  Margin="0,10,10,10" VerticalContentAlignment="Center" Grid.Row="0" Grid.Column="1"/>
            <Button x:Name="SerachBtn" Width="40" Content="🔍" Margin="0,10,10,10" Click="SerachBtn_Click" Grid.Row="0" Grid.Column="2"/>
            <TextBlock Width="20" Text="🍸" VerticalAlignment="Center" Margin="0,10,0,10" Grid.Row="0" Grid.Column="3"/>
            <ComboBox x:Name="ManufCB" Width="20" Margin="0,10,10,10" SelectionChanged="ManufCB_SelectionChanged" Grid.Row="0" Grid.Column="4"/>
        </Grid>
        <ListBox x:Name="PartsLB" Background="#fffcfa" ItemsSource="{Binding Path=baseparts}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top" Margin="10,60,10,10" MinHeight="300" MaxHeight="630">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="280" Width="150" Margin="15,10,10,15" ToolTip="{Binding getall}">
                        <StackPanel Margin="10,10,10,10">
                            <Image Width="130" Height="130" Source="{Binding image}"/>
                            <TextBlock x:Name="NameTB" Text="{Binding name}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ParttypeTB" Text="{Binding parttype.getname}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ManufacturerTB" Text="{Binding manufacturer.getname}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PriceTB" Text="{Binding price, StringFormat=Цена: {0}}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="AddToAssembly_Btn" Content="Добавить в сборку" Click="AddToAssembly_Btn_Click" VerticalAlignment="Bottom"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
