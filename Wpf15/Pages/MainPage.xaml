<Page x:Class="Wpf15.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <StackPanel>
            <Image Source="/Images/dns.png" Height="60" Margin="10, 20, 10, 10"/>
            <TextBlock Text="Конфигуратор ПК" HorizontalAlignment="Center" Margin="10, 10, 10, 10"/>
        </StackPanel>
        <ListBox x:Name="TypesLB" MouseDoubleClick="MouseDoubleClick" Background="#fffcfa" ItemsSource="{Binding Path=types}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Bottom" Margin="10,0,10,20" MinHeight="265" MaxHeight="265" Width="545">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="100" Width="100" Margin="15,10,10,15">
                        <StackPanel>
                            <Image Width="80" Height="80" Source="{Binding image}"/>
                            <TextBlock Text="{Binding typed}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
