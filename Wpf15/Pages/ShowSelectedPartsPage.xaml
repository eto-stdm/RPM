<Page x:Class="Wpf15.Pages.ShowSelectedPartsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf15.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ShowSelectedPartsPage">

    <StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" MinHeight="50" MaxHeight="50">
            <Button x:Name="MainBtn" Margin="10,10,0,10" Click="MainBtn_Click">
                <Image Source="/Images/dns.png"/>
            </Button>
            <TextBlock Text="Моя сборка" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="300,10,10,10"/>
        </StackPanel>
        <ListBox x:Name="DataLB" Background="#fffcfa" ItemsSource="{Binding Path=listassembly}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Bottom" Margin="10,0,10,0" Width="700" MinHeight="330" MaxHeight="350">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="77" Width="330">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="30" Height="30" Source="{Binding image}"/>
                            <TextBlock x:Name="DataTB" Text="{Binding data}" TextWrapping="Wrap" Width="260"/>
                            <TextBlock x:Name="PriceTB" Text="{Binding price, StringFormat=Цена:&#13;{0}}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,10,10,0" VerticalAlignment="Bottom">
            <TextBlock x:Name="PriceTB" Text="Цена:" Margin="0,0,200,0"/>
            <Button x:Name="SaveBtn" Content="Сохранить сборку" Margin="200,0,0,0" Click="SaveBtn_Click"/>
        </StackPanel>
    </StackPanel>
    
</Page>
