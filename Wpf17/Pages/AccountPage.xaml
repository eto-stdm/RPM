<Page x:Class="Wpf17.Pages.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AccountPage">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"></ColumnDefinition>
            <ColumnDefinition Width="530"></ColumnDefinition>
            <ColumnDefinition Width="130"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        <TextBlock Text="Профиль" Grid.Column="1" Grid.Row="0" FontSize="30" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="LoginTB" Text="Логин: " Margin="10"/>
                <TextBlock x:Name="PasswordTB" Text="Пароль: " Margin="10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="RoleTB" Text="Роль: " Margin="10"/>
                <TextBlock x:Name="FIOTB" Text="ФИО: " Margin="10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="BirthDateTB" Text="Дата рождения: " Margin="10"/>
                <TextBlock x:Name="PhoneNumberTB" Text="Номер телефона: " Margin="10"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center">
            <TextBlock Text="История записей" HorizontalAlignment="Center"/>
            <ListBox x:Name="RecordsLB" ItemsSource="{Binding Path=records}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="10" Height="80" Width="500">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="70" Width="470" Margin="10">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding User1.FIO, StringFormat=Мастер: {0}}" Margin="10"/>
                                <TextBlock Text="{Binding DateTime, StringFormat=Дата и время записи: {0}}" Margin="0, 10, 10, 10"/>
                                <TextBlock Text="{Binding ServiceType.Name, StringFormat=Тип услуги: {0}}" Margin="0, 0, 10, 10"/>
                                <TextBlock Text="{Binding Price, StringFormat=Цена: {0} руб.}" Margin="0, 0, 10, 10"/>
                                <TextBlock Text="{Binding PaymentType.Name, StringFormat=Тип оплаты: {0}}" Margin="0, 0, 10, 10"/>
                                <TextBlock Text="{Binding Comment, StringFormat=Комментарий: {0}}" Margin="0, 0, 10, 10"/>
                                <TextBlock Text="{Binding IsDone, StringFormat=Выполнено?: {0}}" Margin="0, 0, 10, 10"/>
                            </WrapPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="3" HorizontalAlignment="Center">
            <TextBlock Text="История заказов" HorizontalAlignment="Center"/>
            <ListBox x:Name="OrdersLB" ItemsSource="{Binding Path=orders}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="10" Height="80" Width="500">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="ProductsTT" Height="50" Width="500" Margin="10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.ToolTip>
                                    <ItemsControl ItemsSource="{Binding ProductOrder}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding All}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding All}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel.ToolTip>

                                <TextBlock Text="{Binding Date, StringFormat=Дата заказа: dd.mm.yyyy}" Margin="0, 10, 10, 10"/>
                                <TextBlock Text="{Binding TotalPrice, StringFormat=Общая цена: {0} руб.}" Margin="0, 10, 10, 10"/>
                                <TextBlock Text="{Binding IsDone, StringFormat=Выполнен?: {0}}" Margin="0, 10, 10, 10"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </StackPanel>
        <Button x:Name="BackBtn" Content="На главную" Grid.Column="0" Grid.Row="3" Height="30" Width="100" Margin="10" VerticalAlignment="Bottom" Click="BackBtn_Click"/>
    </Grid>
</Page>
