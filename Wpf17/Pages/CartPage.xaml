<Page x:Class="Wpf17.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CartPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"></ColumnDefinition>
            <ColumnDefinition Width="600"></ColumnDefinition>
            <ColumnDefinition Width="100"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Корзина" Grid.Column="1" FontSize="30" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <ListBox x:Name="CartLB" Grid.Row="1" Grid.Column="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top" Margin="10" Height="280">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="60" Width="530" Margin="10">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="{Binding Description}">
                            <TextBlock Text="{Binding ProductType.Name}" Margin="0, 10, 10, 10"/>
                            <TextBlock Text="{Binding Manufacturer.Name}" Margin="0, 10, 10, 10"/>
                            <TextBlock Text="{Binding Name}" Margin="0, 10, 10, 10"/>
                            <TextBlock Text="{Binding Price, StringFormat=Цена {0} руб}" Margin="0, 10, 10, 10"/>
                        </WrapPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock Text="Общая цена: " Margin="0,10,10,0"/>
            <TextBlock x:Name="TotalPriceTB" Margin="0,0,10,10" TextWrapping="Wrap"/>
            <Button x:Name="OrderBtn" Content="Заказать" Width="80" Height="30" Margin="0,10,10,10" Click="OrderBtn_Click"/>
        </StackPanel>

        <Button Grid.Row="1" x:Name="BackBtn" Content="Назад" Margin="10" Height="30" Width="80" VerticalAlignment="Bottom" Click="BackBtn_Click"/>
    </Grid>
</Page>
