<Page x:Class="Wpf17.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"></ColumnDefinition>
            <ColumnDefinition Width="600"></ColumnDefinition>
            <ColumnDefinition Width="100"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Продукты" Grid.Column="1" FontSize="30" Margin="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Button x:Name="CartBtn" Grid.Column="2" Content="Корзина" Width="80" Height="30" HorizontalAlignment="Left" Click="CartBtn_Click"/>

        <ListBox x:Name="ProductsLB" Grid.Row="1" Grid.Column="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top" Margin="10" Height="280">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="60" Width="530" Margin="10">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="{Binding Description}">
                            <TextBlock Text="{Binding ProductType.Name}" Margin="0, 10, 10, 10"/>
                            <TextBlock Text="{Binding Manufacturer.Name}" Margin="0, 10, 10, 10"/>
                            <TextBlock Text="{Binding Name}" Margin="0, 10, 10, 10"/>
                            <TextBlock Text="{Binding Price, StringFormat=Цена: {0} руб}" Margin="0, 10, 10, 10"/>
                            <TextBlock Text="{Binding TotalRating, StringFormat=Рейтинг: {0}}" Margin="0, 10, 10, 10"/>
                            <Button x:Name="AddToCart" Content="Добавить в корзину" Height="20" Margin="0,0,0,10" Click="AddToCart_Click"/>
                            <Menu x:Name="RatingMenu" Width="100" Margin="10,0,10,10">
                                <MenuItem Header="Оставьте отзыв" VerticalContentAlignment="Center" Width="100" Height="20" Background="#dddddd" BorderBrush="Black" BorderThickness="1">
                                    <MenuItem x:Name="RatingOneMI" Header="1" Click="RatingOneMI_Click"/>
                                    <MenuItem x:Name="RatingTwoMI" Header="2" Click="RatingTwoMI_Click"/>
                                    <MenuItem x:Name="RatingThreeMI" Header="3" Click="RatingThreeMI_Click"/>
                                    <MenuItem x:Name="RatingFourMI" Header="4" Click="RatingFourMI_Click"/>
                                    <MenuItem x:Name="RatingFiveMI" Header="5" Click="RatingFiveMI_Click"/>
                                </MenuItem>
                            </Menu>
                        </WrapPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <Button Grid.Row="1" x:Name="BackBtn" Content="Назад" Margin="10" Height="30" Width="80" VerticalAlignment="Bottom" Click="BackBtn_Click"/>
    </Grid>
</Page>
