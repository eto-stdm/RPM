<Page x:Class="Wpf17.Pages.MasterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MasterPage">

    <Grid>
        <StackPanel>
            <StackPanel>
                <TextBlock Text="Страница мастера" HorizontalAlignment="Center" FontSize="30" Margin="10"/>
            </StackPanel>
            <ListBox x:Name="RecordsLB" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" VerticalAlignment="Center" Margin="10" MinHeight="300" MaxHeight="300" Width="700">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="50" Width="640" Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="540"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0" ToolTip="{Binding MasterPage}">
                                <TextBlock Text="{Binding MasterServiceType.ServiceType.Name, StringFormat=Тип услуги: {0}}" Margin="0, 10, 10, 10"/>
                                <TextBlock Text="{Binding Date, StringFormat=Дата: dd.mm.yyyy}" Margin="0, 10, 10, 0"/>
                                <TextBlock Text="{Binding RecordTime.Value, StringFormat=Время: {0}}" Margin="0, 10, 10, 0"/>
                                <TextBlock Text="{Binding IsDone, StringFormat=Статус: {0}}" Margin="0, 10, 10, 0"/>
                            </WrapPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Button x:Name="EndBtn" Content="Завершить услугу" FontSize="9" Height="20" Click="EndBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AddBtn" Content="Добавить услугу" Height="20" Width="100" Margin="5,0" Click="AddBtn_Click"/>
                <Button x:Name="DeleteBtn" Content="Убрать услугу" Height="20" Width="100" Margin="5,0" Click="DeleteBtn_Click"/>
                <ComboBox x:Name="ServiceTypesCB" SelectedIndex="0" Margin="5,0"/>
                <ComboBox x:Name="WeekDayCB" SelectedIndex="0"/>
                <Button x:Name="BackBtn" Content="К авторизации" Height="20" Width="100" Margin="20,0" Click="BackBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
