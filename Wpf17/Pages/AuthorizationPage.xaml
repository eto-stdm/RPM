<Page x:Class="Wpf17.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorizationPage">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Вход в аккаунт" FontSize="24" Margin="10" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Логин:" FontSize="20" Margin="10"/>
            <TextBox x:Name="LoginTB" VerticalContentAlignment="Center" Width="250" Margin="0, 10, 10, 10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Пароль:" FontSize="20" Margin="10"/>
                <TextBox x:Name="PasswordTB" VerticalContentAlignment="Center" Width="250" Margin="0, 10, 10, 10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AuthorizBtn" Content="Войти" FontSize="14" Height="30" Width="120" Margin="10" Click="AuthorizBtn_Click"/>
                <Button x:Name="RedirectBtn" Content="Хочу зарегистрироваться" FontSize="14" Height="30" Width="180" Margin="10, 10, 10, 10" Click="RedirectBtn_Click"/>
            </StackPanel>
        </StackPanel>
</Page>
