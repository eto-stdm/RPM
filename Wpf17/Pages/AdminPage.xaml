<Page x:Class="Wpf17.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid>
        <StackPanel>
            <StackPanel>
                <TextBlock Text="Страница админа" HorizontalAlignment="Center" FontSize="30" Margin="10"/>
            </StackPanel>
            <ListBox x:Name="UsersLB" ItemsSource="{Binding Path=types}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" VerticalAlignment="Center" Margin="10" MinHeight="300" MaxHeight="300" Width="700">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="50" Width="640" Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="540"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                                <TextBlock Text="{Binding UserID, StringFormat=ID: {0}}" Margin="0, 10, 10, 0"/>
                                    <TextBlock Text="{Binding Login, StringFormat=Логин: {0}}" Margin="0, 10, 10, 0"/>
                                    <TextBlock Text="{Binding Role.Name, StringFormat=Роль: {0}}" Margin="0, 10, 10, 0"/>
                                    <TextBlock Text="{Binding FIO, StringFormat=ФИО: {0}}" Margin="0, 10, 10, 0"/>
                                    <TextBlock Text="{Binding BirthDate, StringFormat=Дата рождения: dd.mm.yyyy}" Margin="0, 10, 10, 0"/>
                                    <TextBlock Text="{Binding PhoneNumber, StringFormat=Номер телефона: {0}}" Margin="0, 10, 10, 10"/>
                                </WrapPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Menu Height="20">
                                    <MenuItem Header="    Изменить роль" FontSize="9" VerticalContentAlignment="Center" Height="20" Width="100" Background="#dddddd" BorderBrush="Black" BorderThickness="1">
                                        <MenuItem x:Name="ChangeRoleClient" Header="Клиент" Click="ChangeRoleClient_Click"/>
                                        <MenuItem x:Name="ChangeRoleMaster" Header="Мастер" Click="ChangeRoleMaster_Click"/>
                                        <MenuItem x:Name="ChangeRoleManager" Header="Менеджер" Click="ChangeRoleManager_Click"/>
                                        <MenuItem x:Name="ChangeRoleAdmin" Header="Администратор" Click="ChangeRoleAdmin_Click"/>
                                    </MenuItem>
                                </Menu>
                                <Button x:Name="DeleteBtn" Content="Удалить пользователя" FontSize="9" Height="20" Click="DeleteBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AddBtn" Content="Добавить пользователя" Height="20" Width="140" Margin="10,0" Click="AddBtn_Click"/>
                <ComboBox x:Name="RolesCB" SelectedIndex="0">
                    <ComboBoxItem>Клиент</ComboBoxItem>
                    <ComboBoxItem>Мастер</ComboBoxItem>
                    <ComboBoxItem>Менеджер</ComboBoxItem>
                    <ComboBoxItem>Администратор</ComboBoxItem>
                </ComboBox>
                <Button x:Name="BackBtn" Content="К авторизации" Height="20" Width="100" Margin="10,0" Click="BackBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
