<Page x:Class="Wpf17.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf17.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrationPage">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Регистрация" Margin="10, 0, 10, 10" FontSize="24" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Логин:" Margin="10" FontSize="20"/>
            <TextBox x:Name="LoginTB" VerticalContentAlignment="Center" Width="200" Margin="0, 10, 10, 10"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Пароль:" Margin="10" FontSize="20"/>
            <TextBox x:Name="PasswordTB" VerticalContentAlignment="Center" Width="200" Margin="0, 10, 10, 10"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Имя:" Margin="10" FontSize="20"/>
            <TextBox x:Name="NameTB" VerticalContentAlignment="Center" Width="200" Margin="0, 10, 10, 10"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Фамилия:" Margin="10" FontSize="20"/>
            <TextBox x:Name="SurnameTB" VerticalContentAlignment="Center" Width="200" Margin="0, 10, 10, 10"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Отчество:" Margin="10" FontSize="20"/>
            <TextBox x:Name="PatronymTB" VerticalContentAlignment="Center" Width="200" Margin="0, 10, 10, 10"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="Вводите дату в формате 'dd.MM.yyyy'">
            <TextBlock Text="Дата рождения:" Margin="10" FontSize="20"/>
            <TextBox x:Name="BirthDateTB" VerticalContentAlignment="Center" Width="200" Margin="0, 10, 10, 10"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Номер телефона:" Margin="10" FontSize="20"/>
            <TextBox x:Name="PhoneNumberTB" VerticalContentAlignment="Center" Width="200" Margin="0, 10, 10, 10"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="RegistrBtn" Content="Зарегистрироваться" FontSize="14" Height="30" Width="150" Margin="10, 10, 10, 10" Click="RegistrBtn_Click"/>
            <Button x:Name="RedirectBtn" Content="Уже есть аккаунт" FontSize="14" Height="30" Width="150" Margin="10, 10, 10, 10" Click="RedirectBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Page>
