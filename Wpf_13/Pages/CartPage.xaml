<Page x:Class="Wpf_13.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf_13.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="400"
      Title="CartPage">

    <Grid>
        <TextBlock Text="Корзина:" HorizontalAlignment="Center"/>

        <ListBox x:Name="Products_LB" ItemsSource="{Binding Path=cart}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Height="300" VerticalAlignment="Center">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock x:Name="Cart_TB" Text="{Binding ItemID, StringFormat=ID: {0}₽}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="Items_Btn" Content="Товары" Width="60" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="50,0,0,0" Click="Items_Btn_Click"/>
        <Button x:Name="Order_Btn" Content="Заказ" Width="60" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,50,0" Click="Order_Btn_Click"/>
    </Grid>
</Page>
