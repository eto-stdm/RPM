<Page x:Class="Wpf_13.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf_13.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="400"
      Title="OrderPage">

    <Grid>
        <StackPanel>
            <TextBlock Text="Оформление заказа:" Margin="10, 10, 10, 10" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Margin="10, 0, 10, 10">
                <TextBlock Text="ФИО:" Margin="0, 0, 10, 0"/>
                <TextBox x:Name="FIO_TB" Width="150"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10, 0, 10, 10">
                <TextBlock Text="Индекс:"  Margin="0, 0, 10, 0"/>
                <TextBox x:Name="Index_TB" Width="50"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10, 0, 10, 10">
                <TextBlock Text="Адрес доставки:"  Margin="0, 0, 10, 0"/>
                <TextBox x:Name="Address_TB" Width="200"/>
            </StackPanel>
            <TextBlock x:Name="Products_TB" Text="Товары:" Margin="10, 0, 10, 10"/>
            <TextBlock x:Name="Total_TB" Text="Общая цена:" Margin="10, 0, 10, 10"/>
            <Button x:Name="Order_Btn" Content="Заказать" Width="60" Margin="10, 0, 10, 10" Click="Order_Btn_Click"/>
        </StackPanel>
        <Button x:Name="Cart_Btn" Content="Корзина" Width="60" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Click="Cart_Btn_Click"/>
    </Grid>
</Page>
