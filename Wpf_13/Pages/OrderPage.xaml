<Page x:Class="Wpf_13.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf_13.Pages"
      mc:Ignorable="d" 
      Title="OrderPage">

    <Grid>
        <StackPanel>
            <TextBlock Text="Оформление заказа:" Margin="10, 10, 10, 10"/>
            <StackPanel Orientation="Horizontal" Margin="10, 0, 10, 10">
                <TextBlock Text="ФИО:" Margin="0, 0, 10, 0"/>
                <TextBox Width="150"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10, 0, 10, 10">
                <TextBlock Text="Индекс:"  Margin="0, 0, 10, 0"/>
                <TextBox Width="50"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10, 0, 10, 10">
                <TextBlock Text="Адрес доставки:"  Margin="0, 0, 10, 0"/>
                <TextBox Width="200"/>
            </StackPanel>
            <TextBlock Text="Товары:" Margin="10, 0, 10, 10"/>
            <TextBlock Text="Общая цена:" Margin="10, 0, 10, 10"/>
            <Button Content="Заказать" Width="60" Margin="10, 0, 10, 10"/>
        </StackPanel>
    </Grid>
</Page>
