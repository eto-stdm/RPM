<Page x:Class="Wpf_13.ItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf_13"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="400"
      Title="ItemsPage">

    <Grid>
        <TextBlock Text="Товары:" HorizontalAlignment="Center"/>

        <ListBox x:Name="Products_LB" ItemsSource="{Binding Path=items}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Height="300" VerticalAlignment="Center">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Image Width="100" Height="100" Source="{Binding Picture}"/>
                        <TextBlock x:Name="Name_TB" Text="{Binding Name}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="Price_TB" Text="{Binding Price, StringFormat=Цена: {0}₽}" HorizontalAlignment="Center"/>
                        <Button x:Name="AddToCart_Btn" Content="{Binding ID, StringFormat=В корзину {0}}" Click="AddToCart_Btn_Click"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <Button x:Name="Cart_Btn" Content="Корзина" Width="60" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" Click="Cart_Btn_Click"/>
    </Grid>
</Page>
