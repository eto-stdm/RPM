<Page x:Class="Wpf_13.ItemsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf_13"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="400"
      Title="ItemsPage">

    <Grid>
        <TextBlock Text="Товары:" HorizontalAlignment="Center"/>

        <ListBox x:Name="Products_LB" ItemsSource="{Binding Path=products}"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" Height="360" VerticalAlignment="Center">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Image Width="200" Height="200" Source="{Binding}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="Back_Btn" Content="Назад" Width="60" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="50,0,0,0"/>
        <Button x:Name="Forward_Btn" Content="Вперёд" Width="60" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,50,0"/>
    </Grid>
</Page>
