<Page x:Class="Wpf_14.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf_14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="500"
      Title="MainPage">

    <Grid>
        <StackPanel Orientation="Horizontal" Height="50" VerticalAlignment="Top">
            <TextBox x:Name="SearchTB" Width="310" Margin="10,10,10,10"/>
            <Button x:Name="SerachBtn" Width="40" Content="🔍" Margin="0,10,10,10" Click="SerachBtn_Click"/>
            <Button x:Name="SortBtn" Width="40" Content="🍸" Margin="0,10,10,10" Click="SortBtn_Click"/>
            <Button x:Name="AccountBtn" Content="👤" Width="40" Margin="0,10,10,10" Click="AccountBtn_Click"/>
        </StackPanel>
        <ListBox x:Name="FilmsLB" ItemsSource="{Binding Path=films}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Height="400" VerticalAlignment="Bottom">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Image Width="100" Height="100" Source="{Binding Cover}"/>
                        <TextBlock x:Name="NameTB" Text="{Binding Name}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="RatingTB" Text="{Binding RatingID}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DateTB" Text="{Binding Date,StringFormat=Начало показа:&#x0a;dd.MM.yy}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AgeRestrTB" Text="{Binding AgeRestrID}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
