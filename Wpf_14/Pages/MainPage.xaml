<Page x:Class="Wpf_14.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf_14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="500"
      Title="MainPage">

    <Grid>
        <StackPanel Orientation="Horizontal" Height="50" VerticalAlignment="Top" HorizontalAlignment="Center">
            <TextBox x:Name="SearchTB" Width="270" Height="30" Margin="10,10,10,10" VerticalContentAlignment="Center"/>
            <Button x:Name="SerachBtn" Width="40" Content="🔍" Margin="0,10,10,10" Click="SerachBtn_Click"/>

            <Menu Width="40" Margin="0,10,10,10">
                <MenuItem Header=" 🍸" VerticalContentAlignment="Center" Width="40" Height="30" Background="#dddddd" BorderBrush="Black" BorderThickness="1">
                    <MenuItem x:Name="Default" Header="(нет)" Click="Default_Click"/>
                    <Separator/>
                    <MenuItem x:Name="NameSortUp" Header="Название (по возрастанию)" Click="NameSortUp_Click"/>
                    <MenuItem x:Name="NameSortDown" Header="Название (по убыванию)" Click="NameSortDown_Click"/>
                    <Separator/>
                    <MenuItem x:Name="RatingSortUp" Header="Рейтинг (по возрастанию)" Click="RatingSortUp_Click"/>
                    <MenuItem x:Name="RatingSortDown" Header="Рейтинг (по убыванию)" Click="RatingSortDown_Click"/>
                    <Separator/>
                    <MenuItem x:Name="AgeRestrSortUp" Header="Возрастной рейтинг (по возрастанию)" Click="AgeRestrSortUp_Click"/>
                    <MenuItem x:Name="AgeRestrSortDown" Header="Возрастной рейтинг (по убыванию)" Click="AgeRestrSortDown_Click"/>
                </MenuItem>
            </Menu>
            <Button x:Name="AccountBtn" Content="👤" Width="40" Margin="0,10,10,10" Click="AccountBtn_Click"/>
            <Button x:Name="HelpBtn" Content="?" Width="40" Margin="0,10,10,10" Click="HelpBtn_Click"/>
        </StackPanel>
        <ListBox x:Name="FilmsLB" MouseDoubleClick="MouseDoubleClick" ItemsSource="{Binding Path=films}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Width="460" Height="400" VerticalAlignment="Bottom" Margin="0,0,0,13">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="135" Height="230">
                        <StackPanel>
                            <Image Width="130" Height="130" Source="{Binding Cover}" Margin="10,10,10,10"/>
                            <TextBlock x:Name="NameTB" Text="{Binding Name}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RatingTB" Text="{Binding Rating.Amount}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DateTB" Text="{Binding Date,StringFormat=Начало показа: dd.MM.yy}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AgeRestrTB" Text="{Binding AgeRestr.Restriction}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
