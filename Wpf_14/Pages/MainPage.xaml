<Page x:Class="Wpf_14.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf_14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="500"
      Title="MainPage">

    <Grid>
        <StackPanel Orientation="Horizontal" Height="50" VerticalAlignment="Top">
            <TextBox x:Name="Search_TB" Width="300" Margin="10,10,10,10"/>
            <Button x:Name="Serach_Btn" Width="30" Content="🔍" Margin="0,10,10,10"/>
            <Button x:Name="Sort_Btn" Width="80" Content="Сортировка" Margin="0,10,10,10"/>
            <Button x:Name="Account_Btn" Content="Вход" Width="40" Margin="0,10,10,10"/>
        </StackPanel>
        <ListBox x:Name="Films_LB" ItemsSource="{Binding Path=films}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Height="400" VerticalAlignment="Bottom">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Image Width="100" Height="180" Source="{Binding Cover}"/>
                        <TextBlock x:Name="Name_TB" Text="{Binding Name}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="Rating_TB" Text="{Binding Rating}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="Date_TB" Text="{Binding Date, StringFormat=Дата начала показа: {0}}" HorizontalAlignment="Center"/>
						<TextBlock x:Name="AgeRestr_TB" Text="{Binding AgeRestr}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
