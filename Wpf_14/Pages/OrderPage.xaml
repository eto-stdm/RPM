<Page x:Class="Wpf_14.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf_14.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="500"
      Title="OrderPage">

    <Grid>
        <StackPanel>
            <TextBlock x:Name="SessionTB" Text="Сеанс:" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="SeatsTB" Text="Выбранные места:" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="PriceTB" Text="Цена:" HorizontalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AcceptBtn" Content="Подтвердить" Width="100" Margin="10,10,10,10" Click="AcceptBtn_Click"/>
                <Button x:Name="GoBackBtn" Content="Назад" Width="100" Margin="10,10,10,10" Click="GoBackBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
