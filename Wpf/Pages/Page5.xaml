<Page x:Class="Wpf.Pages.Page5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf.Pages"
      mc:Ignorable="d"
      Title="Page5">

    <StackPanel>
        <TextBlock Text="Валидация ввода и оформление заявки" TextAlignment="Center" Margin="10,20,10,20"/>
        <StackPanel Orientation="Horizontal" Margin="10,0,10,10">
            <TextBlock Text="ФИО: "/>
            <TextBox x:Name="NameTB" Width="330" MaxLength="50" TextChanged="NameTB_TextChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10,0,10,10">
            <TextBlock Text="Телефон: "/>
            <TextBox x:Name="PhoneTB" Width="120" PreviewTextInput="PhoneTB_OnPreviewTextInput" MaxLength="11" TextChanged="PhoneTB_TextChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10,0,10,10">
            <TextBlock Text="Адрес электронной почты: "/>
            <TextBox x:Name="EmailTB" Width="150" TextChanged="EmailTB_TextChanged"/>
        </StackPanel>
        <Button x:Name="Exit" Content="Оформить заказ" Margin="10,0,10,10" Click="Exit_Click"/>
    </StackPanel>
</Page>
