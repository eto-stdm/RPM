<Page x:Class="Wpf.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf.Pages"
      mc:Ignorable="d" 
      Title="Page2">

    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10,20,10,20">
            <TextBlock Text="Выберите цвет автомобиля:"/>
            <ComboBox x:Name="ComboBox_Color" Margin="10,0,0,0" SelectionChanged="ComboBox_Color_SelectionChanged">
                <ComboBoxItem>Чёрный графит (+5000₽) </ComboBoxItem>
                <ComboBoxItem>Альпийский снег (+6000₽)</ComboBoxItem>
                <ComboBoxItem>Мальборо (+8000₽)</ComboBoxItem>
                <ComboBoxItem>Мускат (+7000₽)</ComboBoxItem>
                <ComboBoxItem>Лазурь (+4000₽)</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <TextBlock Text="Дополнительные опции:" Margin="10,0,10,10"/>
        <StackPanel Orientation="Vertical" Margin="10,0,10,20">
            <CheckBox Content="Система стабилизации курсовой устойчивости (+10000₽)" Margin="0,0,0,5" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>
            <CheckBox Content="Дополнительные подушки безопасности (+3000₽)" Margin="0,0,0,5" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>
            <CheckBox Content="Подогрев сидений (+1500₽)" Margin="0,0,0,5" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>
            <CheckBox Content="Задний спойлер (+1000₽)" Margin="0,0,0,5" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>
            <CheckBox Content="Хромированная насадка на выхлопную трубу (+50₽)" Margin="0,0,0,5" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>
            <CheckBox Content="Ёлочка (вонючка) (+555₽)" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>
        </StackPanel>
        <Button x:Name="Forward2Button" Content="Вперёд" Margin="300,0,0,0" Height="30" Width="60" Click="Forward2Button_Click"/>
    </StackPanel>
</Page>
