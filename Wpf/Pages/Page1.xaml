<Page x:Class="Wpf.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wpf.Pages"
      mc:Ignorable="d" 
      Title="Page1">

    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10,20,10,20">
            <TextBlock Text="Выберите модель автомобиля:"/>
            <ComboBox x:Name="ComboBox_Model" Margin="10,0,0,0" SelectionChanged="ComboBox_Model_SelectionChanged">
                <ComboBoxItem> Hyundai Creta </ComboBoxItem>
                <ComboBoxItem> Toyota RAV4 </ComboBoxItem>
                <ComboBoxItem> Lada Iskra </ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10,0,10,20">
            <TextBlock Text="Выберите тип двигателя:"/>
            <ComboBox x:Name="ComboBox_Engine" Margin="10,0,0,0" SelectionChanged="ComboBox_Engine_SelectionChanged">
                <ComboBoxItem>Тепловой</ComboBoxItem>
                <ComboBoxItem>Электрический</ComboBoxItem>
                <ComboBoxItem>Гидравлический</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <Button x:Name="Forward1Button" Content="Вперёд" Margin="300,0,0,0" Height="30" Width="60" Click="Forward1Button_Click"/>
    </StackPanel>
</Page>
